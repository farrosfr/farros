# Contact form backend (optional).
# If unset, the contact form on /contact falls back to opening the
# user's email client with a prefilled body addressed to profile.email.
# Sign up free at https://web3forms.com and paste the access key here.
# PUBLIC_ prefix is required: the value is read at build time AND shipped
# to the browser (Web3Forms expects the key in the form payload).
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics (optional).
# Privacy-friendly, no cookies, no consent banner required.
# Setup:
#   1. Open https://dash.cloudflare.com/?to=/:account/web-analytics
#   2. Add a site for farros.co and copy the beacon token
#   3. Paste the token below (or set it in Cloudflare Pages env vars)
# Leave empty to disable analytics entirely. The site ships with no
# tracking by default.
PUBLIC_CF_ANALYTICS_TOKEN=

# Google Search Console Site Verification (optional).
# Setup:
#   1. Open Google Search Console (https://search.google.com/search-console)
#   2. Add your domain property (e.g. farros.co)
#   3. Choose "HTML tag" verification method
#   4. Copy the content attribute of the meta tag and paste it below
PUBLIC_GOOGLE_SITE_VERIFICATION=

