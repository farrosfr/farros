---
import { navItems, searchItems } from '../data/profile';
---

<header class="sticky top-0 z-50 w-full px-4 py-3 sm:py-4">
  <div class="glass mx-auto flex min-h-14 sm:min-h-16 max-w-screen-xl items-center justify-between gap-2 rounded-2xl px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-2 font-bold tracking-tight shrink-0">
      <img src="/logo.png" alt="Farros logo" class="size-8 rounded-lg ring-1 ring-white/10 transition-transform group-hover:scale-105 sm:size-9" />
      <span class="hidden text-lg text-foreground sm:block font-bold">Farros <span class="text-primary">FR</span></span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-primary">
          {item.name}
        </a>
      ))}
    </nav>

    <div class="flex items-center justify-end gap-1 sm:gap-3">
      <button
        type="button"
        data-search-toggle
        class="hidden h-10 w-10 items-center justify-center rounded-xl border border-border/70 bg-card/70 text-muted-foreground transition-colors hover:text-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 md:flex lg:w-auto lg:px-3 lg:gap-2"
        aria-label="Search farrosfr.com"
      >
        <span class="i-lucide-search size-4"></span>
        <span class="hidden lg:inline">Search</span>
        <kbd class="hidden rounded-md border border-border bg-background px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground lg:inline-flex">Ctrl K</kbd>
      </button>

      <button
        type="button"
        data-theme-toggle
        class="hidden md:flex h-10 w-10 items-center justify-center rounded-xl border border-border/70 bg-card/70 text-muted-foreground transition-all hover:text-foreground hover:border-primary/50 focus:outline-none focus:ring-2 focus:ring-primary/50"
        aria-label="Toggle theme"
      >
        <span data-theme-icon-sun class="hidden i-lucide-sun size-5 transition-transform duration-300"></span>
        <span data-theme-icon-moon class="hidden i-lucide-moon size-5 transition-transform duration-300"></span>
      </button>

      <button
        type="button"
        data-menu-toggle
        class="inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-border/70 bg-card/70 px-2 text-sm font-semibold text-foreground transition-colors hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/50 sm:px-3 md:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <span data-menu-open-icon class="i-lucide-menu size-5"></span>
        <span data-menu-close-icon class="i-lucide-x hidden size-5"></span>
        <span class="hidden sm:inline">Menu</span>
      </button>
    </div>
  </div>

  <div
    data-mobile-menu
    class="fixed inset-0 z-[100] hidden flex-col items-center justify-center bg-background/95 p-6 backdrop-blur-xl md:hidden"
  >
    <button
      type="button"
      data-menu-close
      class="absolute right-6 top-6 flex size-12 items-center justify-center rounded-2xl border border-border/70 bg-card/70 text-foreground"
      aria-label="Close navigation"
    >
      <span class="i-lucide-x size-6"></span>
    </button>

    <div class="flex flex-col items-center gap-12 w-full max-w-xs">
      <!-- Mobile Theme & Search Row -->
      <div class="flex w-full gap-2">
        <button
          type="button"
          data-search-toggle
          class="flex h-14 flex-1 items-center justify-center gap-3 rounded-2xl border border-border/70 bg-card/70 font-bold text-foreground transition-all active:scale-95"
        >
          <span class="i-lucide-search size-5"></span>
          <span>Search</span>
        </button>

        <button
          type="button"
          data-theme-toggle
          class="flex h-14 flex-1 items-center justify-center gap-3 rounded-2xl border border-border/70 bg-card/70 font-bold text-foreground transition-all active:scale-95"
          aria-label="Toggle theme"
        >
          <span data-theme-icon-sun class="hidden i-lucide-sun size-5"></span>
          <span data-theme-icon-moon class="hidden i-lucide-moon size-5"></span>
          <span data-theme-mobile-label>Theme</span>
        </button>
      </div>

      <nav class="flex flex-col items-center gap-6 w-full">
        {navItems.map((item) => (
          <a 
            href={item.href} 
            class="w-full rounded-2xl border border-border/40 py-4 text-center text-xl font-bold uppercase tracking-[0.2em] text-muted-foreground transition-all hover:border-primary/50 hover:text-primary active:scale-95"
          >
            {item.name}
          </a>
        ))}
      </nav>
    </div>

    <div class="absolute bottom-12 flex flex-col items-center gap-6">
      <div class="flex items-center gap-6">
        <a href="https://github.com/farrosfr" target="_blank" class="text-muted-foreground hover:text-primary transition-all">
          <div class="i-simple-icons-github size-6"></div>
        </a>
        <a href="https://linkedin.com/in/farrosfr" target="_blank" class="text-muted-foreground hover:text-primary transition-all">
          <div class="i-simple-icons-linkedin size-6"></div>
        </a>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-muted-foreground/60">
        &copy; {new Date().getFullYear()} FARROS FR
      </p>
    </div>
  </div>
</header>

<div
  data-search-palette
  class="fixed inset-0 z-[90] hidden p-4 pt-24 sm:p-6 sm:pt-28"
  role="dialog"
  aria-modal="true"
  aria-label="Search farrosfr.com"
>
  <button data-search-backdrop class="absolute inset-0 cursor-default bg-background/70 backdrop-blur-md" aria-label="Close search"></button>
  <div class="glass relative mx-auto max-w-2xl overflow-hidden rounded-2xl">
    <div class="relative border-b border-border/70">
      <span class="i-lucide-search pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted-foreground"></span>
      <input
        data-search-input
        class="h-14 w-full bg-transparent pl-12 pr-4 text-sm font-medium text-foreground outline-none placeholder:text-muted-foreground"
        placeholder="Search work, CV, certificates, writing, or contact..."
        autocomplete="off"
      />
    </div>
    <div data-search-results class="max-h-[26rem] overflow-y-auto p-3"></div>
  </div>
</div>

<script>
  function setupHeaderControls() {
    const root = document.documentElement;
    const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');
    const themeButtons = document.querySelectorAll('[data-theme-toggle]');

    function syncUI(isDark: boolean) {
      themeButtons.forEach((btn) => {
        const sunIcon = btn.querySelector('[data-theme-icon-sun]');
        const moonIcon = btn.querySelector('[data-theme-icon-moon]');
        const mobileLabel = btn.querySelector('[data-theme-mobile-label]');

        if (isDark) {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
          if (mobileLabel) mobileLabel.textContent = 'Light Mode';
          btn.setAttribute('aria-label', 'Switch to light theme');
        } else {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
          if (mobileLabel) mobileLabel.textContent = 'Dark Mode';
          btn.setAttribute('aria-label', 'Switch to dark theme');
        }
      });
    }

    function applyTheme(isDark: boolean) {
      root.classList.toggle('dark', isDark);
      root.dataset.themeMode = isDark ? 'dark' : 'light';
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      syncUI(isDark);
    }

    function handleThemeToggle(event: Event) {
      const isDark = root.classList.contains('dark');
      const nextIsDark = !isDark;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('startViewTransition' in document) || prefersReduced) {
        applyTheme(nextIsDark);
        return;
      }

      const mouseEvent = event as MouseEvent;
      const target = (event.currentTarget || event.target) as HTMLElement | null;
      const rect = target?.getBoundingClientRect?.();
      const x = mouseEvent.clientX && mouseEvent.clientX > 0 ? mouseEvent.clientX : (rect ? rect.left + rect.width / 2 : window.innerWidth / 2);
      const y = mouseEvent.clientY && mouseEvent.clientY > 0 ? mouseEvent.clientY : (rect ? rect.top + rect.height / 2 : 0);

      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = (document as any).startViewTransition(() => {
        applyTheme(nextIsDark);
      });

      transition.ready.then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${endRadius}px at ${x}px ${y}px)`
            ]
          },
          {
            duration: 450,
            easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
            pseudoElement: '::view-transition-new(root)'
          }
        );
      });
    }

    themeButtons.forEach((btn) => {
      if (btn.getAttribute('data-bound') === 'true') return;
      btn.setAttribute('data-bound', 'true');
      btn.addEventListener('click', handleThemeToggle);
    });

    if (!(window as any).__farrosSystemThemeBound) {
      (window as any).__farrosSystemThemeBound = true;
      systemQuery.addEventListener('change', (e) => {
        if (!localStorage.getItem('theme')) {
          applyTheme(e.matches);
        }
      });
    }

    syncUI(root.classList.contains('dark'));

    const menuButton = document.querySelector('[data-menu-toggle]');
    const closeButton = document.querySelector('[data-menu-close]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    if (!menuButton || !mobileMenu) return;

    function openMobileMenu() {
      mobileMenu.classList.remove('hidden');
      mobileMenu.classList.add('flex');
      document.body.style.overflow = 'hidden';
      menuButton.setAttribute('aria-expanded', 'true');
    }

    function closeMobileMenu() {
      mobileMenu.classList.add('hidden');
      mobileMenu.classList.remove('flex');
      document.body.style.overflow = '';
      menuButton.setAttribute('aria-expanded', 'false');
    }

    if (mobileMenu.getAttribute('data-link-bound') !== 'true') {
      mobileMenu.setAttribute('data-link-bound', 'true');
      mobileMenu.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a') : null;
        if (target) closeMobileMenu();
      });
    }

    if (menuButton.getAttribute('data-bound') !== 'true') {
      menuButton.setAttribute('data-bound', 'true');
      menuButton.addEventListener('click', openMobileMenu);
    }

    if (closeButton && closeButton.getAttribute('data-bound') !== 'true') {
      closeButton.setAttribute('data-bound', 'true');
      closeButton.addEventListener('click', closeMobileMenu);
    }
  }

  setupHeaderControls();
  document.addEventListener('astro:page-load', setupHeaderControls);
</script>

<script define:vars={{ searchItems }}>
  function setupSearchPalette() {
    const palette = document.querySelector('[data-search-palette]');
    const input = document.querySelector('[data-search-input]');
    const results = document.querySelector('[data-search-results]');
    const toggles = document.querySelectorAll('[data-search-toggle]');
    const backdrop = document.querySelector('[data-search-backdrop]');

    if (!palette || !input || !results) return;

    function render(query = '') {
      const normalized = query.trim().toLowerCase();
      const matches = searchItems.filter((item) => {
        const haystack = `${item.title} ${item.description} ${item.type}`.toLowerCase();
        return !normalized || haystack.includes(normalized);
      });

      results.innerHTML = matches.length
        ? matches.map((item) => `
          <a href="${item.href}" class="group flex items-center gap-4 rounded-xl p-3 transition-colors hover:bg-muted">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl border border-border bg-background font-mono text-[10px] font-bold uppercase text-primary">${item.type.slice(0, 1)}</span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-bold text-foreground">${item.title}</span>
              <span class="block truncate text-xs text-muted-foreground">${item.description}</span>
            </span>
            <span class="i-lucide-arrow-up-right size-4 text-muted-foreground transition-colors group-hover:text-primary"></span>
          </a>
        `).join('')
        : '<p class="px-4 py-10 text-center text-sm text-muted-foreground">No matching results.</p>';
    }

    function openPalette() {
      palette.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      render(input.value);
      setTimeout(() => input.focus(), 0);
    }

    function closePalette() {
      palette.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
      render();
    }

    if (palette.getAttribute('data-bound') !== 'true') {
      palette.setAttribute('data-bound', 'true');
      input.addEventListener('input', () => render(input.value));
      results.addEventListener('click', (event) => {
        const target = event.target instanceof Element ? event.target.closest('a') : null;
        if (target) closePalette();
      });
      backdrop?.addEventListener('click', closePalette);
      window.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          openPalette();
        }
        if (event.key === 'Escape' && !palette.classList.contains('hidden')) {
          closePalette();
        }
      });
    }

    toggles.forEach((button) => {
      if (button.getAttribute('data-bound') === 'true') return;
      button.setAttribute('data-bound', 'true');
      button.addEventListener('click', openPalette);
    });

    render();
  }

  setupSearchPalette();
  document.addEventListener('astro:page-load', setupSearchPalette);
</script>
