---
// NoArousal - Streak Log Timeline
---

<section id="streak-log" class="w-full max-w-4xl mx-auto mb-16 sm:mb-20">
  <!-- Section Title with Horizontal Rule -->
  <div class="flex items-center gap-4 mb-8">
    <h2 class="font-serif text-2xl sm:text-[26px] text-[#E9DDC9] font-normal tracking-tight">
      Streak log
    </h2>
    <div class="h-[1px] flex-1 bg-[#554936]" aria-hidden="true"></div>
  </div>

  <!-- Timeline Container -->
  <div class="relative pl-6 sm:pl-8 text-left">
    <!-- Vertical Connecting Line -->
    <div class="absolute left-[7px] sm:left-[9px] top-3 bottom-3 w-[1px] bg-[#554936]" aria-hidden="true"></div>

    <!-- Timeline Entries will be populated dynamically by the client script and pre-rendered cleanly -->
    <div id="timeline-list" class="flex flex-col gap-5 sm:gap-6">
      <!-- Fallback / Initial Server Rendered Placeholder (Updated on client) -->
      <div class="relative flex items-center gap-4 sm:gap-6 text-xs sm:text-sm">
        <span class="absolute -left-6 sm:-left-8 w-3 h-3 rounded-full border border-[#D6B17A] bg-[#071116] -translate-x-[2.5px]"></span>
        <span class="font-cinzel tracking-wider text-[#E9DDC9] min-w-[95px] sm:min-w-[110px]">12 NOV 2026</span>
        <span class="text-[#746047] select-none">&mdash;</span>
        <span class="font-serif text-[#A99D8A]">Commitment started</span>
      </div>
    </div>
  </div>
</section>
