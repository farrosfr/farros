---
// NoArousal - Milestone Grid Section
import { MILESTONES } from '../../lib/no-arousal/milestones';
---

<section class="w-full max-w-4xl mx-auto mb-14 sm:mb-16">
  <!-- Section Title with Horizontal Rule -->
  <div class="flex items-center gap-4 mb-6">
    <h2 class="font-serif text-2xl sm:text-[26px] text-[#E9DDC9] font-normal tracking-tight">
      Milestones
    </h2>
    <div class="h-[1px] flex-1 bg-[#554936]" aria-hidden="true"></div>
  </div>

  <!-- 5 Cards Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
    {MILESTONES.map((m) => (
      <div
        id={`milestone-card-${m.id}`}
        data-milestone-id={m.id}
        data-milestone-days={m.days}
        class="milestone-card group relative flex flex-col items-center justify-center p-5 sm:p-6 bg-[#0D191D]/80 border border-[#554936] text-center transition-all duration-300 hover:border-[#746047]"
      >
        <!-- Lock / Unlock Icon -->
        <div class="milestone-icon-container mb-3 text-[#746047] transition-colors duration-300">
          <!-- Locked Icon (Default) -->
          <svg class="icon-locked w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="1" ry="1"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <!-- Unlocked Icon (When Completed) -->
          <svg class="icon-unlocked w-5 h-5 hidden text-[#D6B17A]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="1" ry="1"></rect>
            <path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
          </svg>
        </div>

        <!-- Duration Label -->
        <span class="font-cinzel text-xs sm:text-[13px] tracking-[0.16em] uppercase text-[#E9DDC9] font-medium mb-1">
          {m.label}
        </span>

        <!-- Milestone Name -->
        <span class="font-serif text-xs sm:text-sm text-[#A99D8A] font-light">
          {m.sublabel}
        </span>
      </div>
    ))}
  </div>
</section>
