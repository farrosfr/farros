---
// NoArousal - Minimalist Navigation Header
---

<header class="sticky top-0 z-50 w-full border-b border-[#554936]/40 bg-[#071116]/80 backdrop-blur-md transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-5 sm:px-8 lg:px-12">
    <!-- Brand: Sword + Wordmark -->
    <a href="#overview" class="group flex items-center gap-2.5 text-[#E9DDC9] transition-opacity hover:opacity-85 focus:outline-none focus:ring-1 focus:ring-[#D6B17A]/40">
      <svg
        viewBox="0 0 20 28"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="22"
        style="width: 16px; height: 22px; max-width: 16px; max-height: 22px;"
        class="h-5 w-auto text-[#D6B17A] flex-shrink-0 transition-transform duration-300 group-hover:scale-105"
      >
        <circle cx="10" cy="2.5" r="1.5" fill="#D6B17A" />
        <rect x="9.25" y="4" width="1.5" height="4" rx="0.5" fill="#D6B17A" />
        <path d="M4 8.5C5.5 8.5 7 8 10 8C13 8 14.5 8.5 16 8.5C16.5 8.5 16.5 9.5 16 9.5C13 9.5 11.5 9 10 9C8.5 9 7 9.5 4 9.5C3.5 9.5 3.5 8.5 4 8.5Z" fill="#D6B17A" />
        <path d="M9.25 9.5L9.5 24.5L10 27L10.5 24.5L10.75 9.5H9.25Z" fill="#D6B17A" />
      </svg>
      <span class="font-serif text-xl sm:text-2xl tracking-[0.02em] font-medium text-[#E9DDC9]">NoArousal</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 lg:gap-9" aria-label="Main Navigation">
      <a href="#overview" class="font-cinzel text-xs tracking-[0.16em] uppercase text-[#A99D8A] transition-colors hover:text-[#E9DDC9] focus:outline-none focus:text-[#E9DDC9]">
        Overview
      </a>
      <a href="#principles" class="font-cinzel text-xs tracking-[0.16em] uppercase text-[#A99D8A] transition-colors hover:text-[#E9DDC9] focus:outline-none focus:text-[#E9DDC9]">
        Principles
      </a>
      <a href="#streak-log" class="font-cinzel text-xs tracking-[0.16em] uppercase text-[#A99D8A] transition-colors hover:text-[#E9DDC9] focus:outline-none focus:text-[#E9DDC9]">
        Journal
      </a>
      <a
        href="#check-in"
        class="border border-[#746047] bg-[#0D191D]/60 px-4 py-1.5 font-cinzel text-xs tracking-[0.16em] uppercase text-[#E9DDC9] transition-all hover:border-[#D6B17A] hover:bg-[#D6B17A]/10 hover:text-white focus:outline-none focus:ring-1 focus:ring-[#D6B17A]"
      >
        Daily check-in
      </a>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      type="button"
      id="na-mobile-menu-btn"
      class="flex md:hidden items-center justify-center p-2 text-[#A99D8A] hover:text-[#E9DDC9] focus:outline-none"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="na-mobile-nav"
    >
      <svg class="h-5 w-5" width="20" height="20" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Collapsible Navigation Menu -->
  <div
    id="na-mobile-nav"
    class="hidden border-b border-[#554936]/40 bg-[#071116]/95 px-6 py-4 md:hidden backdrop-blur-xl transition-all"
  >
    <nav class="flex flex-col gap-4 text-center">
      <a href="#overview" class="na-mobile-link font-cinzel text-sm tracking-[0.18em] uppercase text-[#A99D8A] py-1 hover:text-[#E9DDC9]">
        Overview
      </a>
      <a href="#principles" class="na-mobile-link font-cinzel text-sm tracking-[0.18em] uppercase text-[#A99D8A] py-1 hover:text-[#E9DDC9]">
        Principles
      </a>
      <a href="#streak-log" class="na-mobile-link font-cinzel text-sm tracking-[0.18em] uppercase text-[#A99D8A] py-1 hover:text-[#E9DDC9]">
        Journal
      </a>
      <a
        href="#check-in"
        class="na-mobile-link mx-auto mt-2 w-full max-w-xs border border-[#746047] bg-[#0D191D] py-2 font-cinzel text-xs tracking-[0.18em] uppercase text-[#E9DDC9] hover:border-[#D6B17A]"
      >
        Daily check-in
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('na-mobile-menu-btn');
  const menu = document.getElementById('na-mobile-nav');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
    });

    document.querySelectorAll('.na-mobile-link').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
