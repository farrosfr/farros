---
// NoArousal - Daily Principles Section
---

<section id="principles" class="w-full max-w-4xl mx-auto mb-14 sm:mb-16">
  <!-- Section Title with Horizontal Rule -->
  <div class="flex items-center gap-4 mb-6">
    <h2 class="font-serif text-2xl sm:text-[26px] text-[#E9DDC9] font-normal tracking-tight">
      Daily principles
    </h2>
    <div class="h-[1px] flex-1 bg-[#554936]" aria-hidden="true"></div>
  </div>

  <!-- 3 Principles Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    
    <!-- Principle 1: Awareness -->
    <div class="flex items-center gap-4 sm:gap-5 p-5 sm:p-6 bg-[#0D191D]/80 border border-[#554936] transition-all duration-300 hover:border-[#746047]">
      <div class="flex-shrink-0 text-[#D6B17A]" aria-hidden="true">
        <!-- Eye Icon -->
        <svg class="w-6 h-6" width="24" height="24" style="width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="#D6B17A" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </div>
      <div class="h-10 w-[1px] bg-[#554936]" aria-hidden="true"></div>
      <div class="text-left">
        <h3 class="font-serif text-lg text-[#E9DDC9] font-normal leading-snug">
          Awareness
        </h3>
        <p class="font-serif text-xs sm:text-[13px] text-[#A99D8A] font-light leading-relaxed mt-0.5">
          Recognize the trigger, don't follow it.
        </p>
      </div>
    </div>

    <!-- Principle 2: Discipline -->
    <div class="flex items-center gap-4 sm:gap-5 p-5 sm:p-6 bg-[#0D191D]/80 border border-[#554936] transition-all duration-300 hover:border-[#746047]">
      <div class="flex-shrink-0 text-[#D6B17A]" aria-hidden="true">
        <!-- Shield with checkmark -->
        <svg class="w-6 h-6" width="24" height="24" style="width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="#D6B17A" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
      </div>
      <div class="h-10 w-[1px] bg-[#554936]" aria-hidden="true"></div>
      <div class="text-left">
        <h3 class="font-serif text-lg text-[#E9DDC9] font-normal leading-snug">
          Discipline
        </h3>
        <p class="font-serif text-xs sm:text-[13px] text-[#A99D8A] font-light leading-relaxed mt-0.5">
          Choose the action that aligns with your intent.
        </p>
      </div>
    </div>

    <!-- Principle 3: Consistency -->
    <div class="flex items-center gap-4 sm:gap-5 p-5 sm:p-6 bg-[#0D191D]/80 border border-[#554936] transition-all duration-300 hover:border-[#746047]">
      <div class="flex-shrink-0 text-[#D6B17A]" aria-hidden="true">
        <!-- Stacked layers icon -->
        <svg class="w-6 h-6" width="24" height="24" style="width: 24px; height: 24px;" viewBox="0 0 24 24" fill="none" stroke="#D6B17A" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
      <div class="h-10 w-[1px] bg-[#554936]" aria-hidden="true"></div>
      <div class="text-left">
        <h3 class="font-serif text-lg text-[#E9DDC9] font-normal leading-snug">
          Consistency
        </h3>
        <p class="font-serif text-xs sm:text-[13px] text-[#A99D8A] font-light leading-relaxed mt-0.5">
          Return to the commitment, every day.
        </p>
      </div>
    </div>

  </div>
</section>
