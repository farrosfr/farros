---
// NoArousal - Next Milestone Progress Panel
---

<div class="w-full max-w-4xl mx-auto mb-14 sm:mb-16">
  <div class="relative bg-[#0D191D]/85 border border-[#554936] p-6 sm:p-7 md:p-8 backdrop-blur-sm">
    <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1.6fr] items-center gap-6 md:gap-8">
      
      <!-- Left: Milestone Overview -->
      <div class="flex flex-col justify-center text-left">
        <span class="font-serif text-lg sm:text-xl text-[#E9DDC9] font-normal mb-1">
          The next milestone
        </span>
        <div class="flex items-baseline gap-3 my-0.5">
          <span id="next-milestone-title" class="font-serif text-2xl sm:text-3xl font-bold text-[#E9DDC9] tracking-tight">
            7 DAYS
          </span>
        </div>
        <span id="next-milestone-remaining" class="font-serif text-sm text-[#A99D8A] font-light">
          3 days to go
        </span>
      </div>

      <!-- Vertical Divider (Desktop) -->
      <div class="hidden md:block w-[1px] h-full min-h-[70px] bg-[#554936]" aria-hidden="true"></div>

      <!-- Right: Percentage & Progress Bar -->
      <div class="flex flex-col justify-center text-left">
        <div class="flex items-center justify-between mb-2">
          <span id="milestone-percentage-text" class="font-cinzel text-[11px] tracking-[0.22em] uppercase text-[#A99D8A]">
            57% COMPLETE
          </span>
        </div>

        <!-- Progress Track -->
        <div class="w-full h-1.5 bg-[#071116] border border-[#554936]/70 rounded-none overflow-hidden my-1">
          <div
            id="milestone-progress-bar"
            class="h-full bg-gradient-to-r from-[#A88653] via-[#D6B17A] to-[#E5C99B] transition-all duration-700 ease-out"
            style="width: 57%;"
            role="progressbar"
            aria-valuenow="57"
            aria-valuemin="0"
            aria-valuemax="100"
          ></div>
        </div>

        <p class="font-serif italic text-xs sm:text-sm text-[#A99D8A] font-light mt-2">
          Consistency is built one day at a time.
        </p>
      </div>

    </div>
  </div>
</div>
