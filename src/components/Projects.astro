---
import { featuredProjects } from '../data/profile';
---

<section id="projects" class="py-20 md:py-28">
  <div class="mb-10 flex flex-col gap-5 md:mb-14 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-primary">Top web portfolio</p>
      <h2 class="text-4xl font-bold tracking-tight sm:text-5xl">Selected production websites with the strongest public-facing work.</h2>
    </div>
    <div class="max-w-md">
      <p class="text-base leading-7 text-muted-foreground">
        A focused view of the top web projects. The full portfolio has the complete production list across commerce, education, energy, and services.
      </p>
      <a href="/web-porto/" class="mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-full border border-border bg-card/70 px-5 text-sm font-bold text-foreground transition-all hover:-translate-y-1 hover:border-primary/40 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/50">
        See full web portfolio
        <span class="i-lucide-arrow-right size-4"></span>
      </a>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    {featuredProjects.map((project) => (
      <a
        href={project.href}
        target="_blank"
        rel="noreferrer"
        class="group glass-card relative flex min-h-[390px] flex-col overflow-hidden rounded-[1.5rem] p-4 hover:-translate-y-1"
      >
        <div class="relative h-44 overflow-hidden rounded-[1.15rem] border border-border/70 bg-muted">
          <img src={project.image} alt={`${project.name} website screenshot`} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent"></div>
          <span class="absolute left-3 top-3 rounded-full border border-border/70 bg-background/80 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-primary backdrop-blur">
            {project.category}
          </span>
        </div>

        <div class="flex flex-col p-2 pt-5">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-muted-foreground">{project.domain}</p>
              <h3 class="mt-2 text-2xl font-bold tracking-tight text-foreground">{project.name}</h3>
            </div>
            <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-background/70 text-muted-foreground transition-all group-hover:border-primary/50 group-hover:text-primary">
              <span class="i-lucide-arrow-up-right size-5"></span>
            </span>
          </div>

          <div class="pt-6">
            <p class="max-w-xl text-sm leading-6 text-muted-foreground transition-colors group-hover:text-foreground">{project.description}</p>
            <div class="mt-4 inline-flex rounded-full border border-border/70 bg-background/70 px-3 py-1 font-mono text-[11px] text-primary">
              {project.outcome}
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
