---
import { services } from '../data/profile';
---

<section id="services" class="py-20 md:py-28" data-reveal>
  <div class="mb-12 flex flex-col items-center text-center">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">Catalog</p>
    <h2 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl">Professional Advisory Services</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted-foreground">
      Expert-led solutions across high-performance engineering, cybersecurity, and data.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((service) => (
      <a
        href={`/services/${service.slug}`}
        class="group glass-card overflow-hidden rounded-[2rem] transition-all hover:-translate-y-2 hover:border-primary/40"
      >
        <div class="aspect-square w-full overflow-hidden">
          <img
            src={service.image}
            alt={service.title}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
          />
        </div>
        <div class="p-8">
          <div class="flex items-center justify-between gap-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">{service.category}</p>
            <span class="i-lucide-arrow-up-right size-5 text-muted-foreground transition-colors group-hover:text-primary"></span>
          </div>
          <h3 class="mt-4 text-2xl font-bold text-foreground group-hover:text-primary transition-colors">{service.title}</h3>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{service.description}</p>
        </div>
      </a>
    ))}
  </div>
</section>
