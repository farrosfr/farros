---
import { featuredWork, heroMetrics, profile } from '../data/profile';
---

<section class="relative grid min-h-[calc(100vh-8rem)] items-center gap-12 py-12 md:grid-cols-[1.04fr_0.96fr] md:py-24">
  <div class="animate flex flex-col gap-7 md:gap-8">
    <div class="inline-flex w-fit items-center gap-3 rounded-full border border-border/70 bg-card/65 px-4 py-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-muted-foreground backdrop-blur-xl">
      <span class="relative flex h-2 w-2">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      Web • Security • Data Engineering
    </div>

    <div class="flex flex-col gap-5 md:gap-6">
      <h1 class="max-w-3xl text-[2.5rem] font-bold leading-[1.15] tracking-tight text-foreground sm:text-5xl md:leading-[1.06]">
        Building fast web products and resilient operating systems.
      </h1>
      <p class="max-w-3xl text-sm leading-relaxed text-muted-foreground/80 md:text-lg md:leading-8">
        I am a full-stack developer and system architect working with Astro, TypeScript, data engineering, infrastructure operations, browser extensions, and cybersecurity writing.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/cv" class="group inline-flex h-14 items-center justify-center gap-2 rounded-full bg-primary px-7 text-sm font-bold text-primary-foreground shadow-xl shadow-primary/20 transition-all hover:-translate-y-0.5 hover:shadow-primary/30 focus:outline-none focus:ring-2 focus:ring-primary/50">
        View CV
        <span class="i-lucide-arrow-up-right size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"></span>
      </a>
      <a href="#projects" class="inline-flex h-14 items-center justify-center rounded-full border border-border bg-card/70 px-7 text-sm font-bold text-foreground transition-all hover:-translate-y-0.5 hover:border-primary/40 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary/50">
        Review selected work
      </a>
    </div>

    <div class="grid grid-cols-2 gap-3 pt-4 sm:grid-cols-4">
      {heroMetrics.map((metric) => (
        <div class="glass-card rounded-2xl p-4">
          <div class="font-mono text-2xl font-bold text-primary">{metric.value}</div>
          <div class="mt-2 text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">{metric.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="animate relative [animation-delay:160ms]">
    <div class="absolute -inset-4 rounded-[2rem] bg-primary/10 blur-3xl"></div>
    <div class="glass-card relative overflow-hidden rounded-[1.75rem] p-5">
      <div class="mb-5 flex items-center justify-between border-b border-border/70 pb-4">
        <div class="flex items-center gap-3">
          <div>
            <p class="text-sm font-bold">{profile.name}</p>
            <p class="text-xs text-muted-foreground">{profile.title}</p>
          </div>
        </div>
        <div class="rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-emerald-500 dark:text-emerald-300">
          Active
        </div>
      </div>

      <div class="grid gap-4">
        <div class="rounded-2xl border border-border/70 bg-background/70 p-5">
          <div class="mb-4 flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-[0.16em] text-muted-foreground">Featured systems</span>
            <span class="font-mono text-xs text-primary">03 signals</span>
          </div>
          <div class="grid gap-3">
            {featuredWork.map((item, index) => (
              <a href={item.href} target="_blank" rel="noreferrer" class="flex items-center gap-3 rounded-xl border border-border/50 bg-card/80 p-3 transition-colors hover:border-primary/40">
                <span class={`size-2.5 rounded-full ${index === 0 ? 'bg-primary' : index === 1 ? 'bg-accent' : 'bg-emerald-400'}`}></span>
                <span class="min-w-0">
                  <span class="block text-sm font-bold text-foreground">{item.name}</span>
                  <span class="block truncate text-xs text-muted-foreground">{item.type}</span>
                </span>
                <span class="ml-auto font-mono text-xs text-muted-foreground">0{index + 1}</span>
              </a>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="rounded-2xl border border-border/70 bg-background/70 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Core stack</p>
            <p class="mt-3 font-mono text-2xl font-bold text-foreground">Astro</p>
          </div>
          <div class="rounded-2xl border border-border/70 bg-background/70 p-4">
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">Security writing</p>
            <p class="mt-3 font-mono text-2xl font-bold text-foreground">70+</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
