---
---
<section class="relative flex flex-col gap-10 py-20 md:py-32 overflow-hidden">
  <div class="flex flex-col gap-6 animate">
    <div class="flex items-center gap-3">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-muted-foreground/80 font-sans">
        Available for critical infrastructure projects
      </span>
    </div>
    
    <div class="flex flex-col gap-2">
      <h1 class="text-6xl font-bold tracking-tighter sm:text-7xl lg:text-8xl leading-[0.9] text-foreground">
        Securing the <br /> 
        <span class="text-primary italic font-serif font-light">Digital Frontier</span>.
      </h1>
    </div>

    <div class="flex flex-col gap-4 max-w-2xl">
      <h2 class="text-xl md:text-2xl font-medium text-foreground/90 tracking-tight">
        Independent Cybersecurity Researcher & Data Engineer
      </h2>
      <p class="text-muted-foreground text-lg leading-relaxed font-light">
        I specialize in identifying systemic vulnerabilities and architecting resilient data pipelines for high-stakes environments. Helping organizations build trust through proactive security.
      </p>
    </div>
  </div>

  <div class="flex flex-wrap gap-4 animate [animation-delay:200ms]">
    <a 
      href="#projects" 
      class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-full bg-primary px-10 text-sm font-semibold text-primary-foreground transition-all hover:scale-[1.02] active:scale-[0.98]"
    >
      <span class="relative z-10">Explore Work</span>
      <div class="absolute inset-0 bg-white/20 translate-y-full transition-transform group-hover:translate-y-0"></div>
    </a>
    <a 
      href="mailto:hello@farros.co" 
      class="inline-flex h-14 items-center justify-center rounded-full border-2 border-border bg-background px-10 text-sm font-semibold transition-all hover:bg-muted hover:border-muted-foreground/20 active:scale-[0.98]"
    >
      Inquire
    </a>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-10 animate [animation-delay:400ms]">
    {[
      { label: 'Security Audits', value: '50+' },
      { label: 'CVEs Identified', value: '12' },
      { label: 'Systems Hardened', value: '100+' },
      { label: 'Uptime Focus', value: '99.9%' }
    ].map((stat) => (
      <div class="glass-card p-6 rounded-2xl">
        <div class="text-2xl font-bold text-primary font-mono">{stat.value}</div>
        <div class="text-xs uppercase tracking-widest text-muted-foreground mt-1">{stat.label}</div>
      </div>
    ))}
  </div>
</section>
