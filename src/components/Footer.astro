---

<footer class="border-t border-border/60 py-12">
  <div class="flex flex-col justify-between gap-8 md:flex-row md:items-center">
    <div class="flex max-w-md items-start gap-4">
      <img src="/logo.png" alt="Farros logo" class="size-11 rounded-xl ring-1 ring-white/10" />
      <div>
        <a href="/" class="text-xl font-bold tracking-tight">Farros<span class="text-primary">.co</span></a>
        <p class="mt-2 text-sm leading-6 text-muted-foreground">
          Security research and resilient data infrastructure for teams that need production trust.
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-4 md:items-end">
      <div class="flex items-center gap-4">
        <a href="https://github.com/farrosfr" target="_blank" rel="noreferrer" aria-label="GitHub" class="inline-flex size-10 items-center justify-center rounded-xl border border-border bg-card/70 text-muted-foreground transition-colors hover:text-primary">
          <span class="i-simple-icons-github size-5"></span>
        </a>
        <a href="https://linkedin.com/in/farrosfr" target="_blank" rel="noreferrer" aria-label="LinkedIn" class="inline-flex size-10 items-center justify-center rounded-xl border border-border bg-card/70 text-muted-foreground transition-colors hover:text-primary">
          <span class="i-simple-icons-linkedin size-5"></span>
        </a>
        <a href="https://x.com/farrosfr_" target="_blank" rel="noreferrer" aria-label="X" class="inline-flex size-10 items-center justify-center rounded-xl border border-border bg-card/70 text-muted-foreground transition-colors hover:text-primary">
          <span class="i-simple-icons-x size-5"></span>
        </a>
      </div>
      <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-muted-foreground/70">
        &copy; {new Date().getFullYear()} Farros FR. All rights reserved.
      </p>
    </div>
  </div>
</footer>
