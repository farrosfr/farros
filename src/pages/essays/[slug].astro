---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const essays = await getCollection('writing');
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const date = essay.data.pubDate;
const dateLabel = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = essay.data.updated
  ? essay.data.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: essay.data.title,
  description: essay.data.description,
  datePublished: essay.data.pubDate.toISOString(),
  ...(essay.data.updated ? { dateModified: essay.data.updated.toISOString() } : {}),
  author: {
    '@type': 'Person',
    name: profile.name,
    url: profile.website,
  },
  publisher: {
    '@type': 'Person',
    name: profile.name,
    url: profile.website,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/essays/${essay.id}`, Astro.site ?? 'https://porto.farrosfr.com').toString(),
  },
  keywords: essay.data.tags.join(', ') || undefined,
};
---

<BaseLayout title={`${essay.data.title} | ${profile.shortName}`} description={essay.data.description} ogType="article">
  <main class="mx-auto max-w-screen-md px-4 py-12 sm:px-6 lg:px-8" data-reveal>
    <Breadcrumbs
      items={[
        { name: 'Home', href: '/' },
        { name: 'Writing', href: '/writing' },
        { name: essay.data.title },
      ]}
      class="mb-8"
    />
    <article>
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-bold uppercase tracking-[0.18em] text-primary">
          <span>{dateLabel}</span>
          {essay.data.readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{essay.data.readingTime} read</span>
            </>
          )}
          {updated && (
            <>
              <span aria-hidden="true">·</span>
              <span class="text-muted-foreground">Updated {updated}</span>
            </>
          )}
        </div>
        <h1 class="mt-4 text-4xl font-bold leading-[1.05] tracking-tight text-foreground sm:text-5xl">{essay.data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">{essay.data.description}</p>
        {essay.data.tags.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" data-essay-tags>
            {essay.data.tags.map((tag) => (
              <li class="rounded-full border border-border bg-card/70 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">{tag}</li>
            ))}
          </ul>
        )}
      </header>

      <div class="prose prose-lg dark:prose-invert max-w-none
        prose-headings:tracking-tight
        prose-h2:mt-12 prose-h2:text-2xl prose-h2:font-bold
        prose-h3:mt-8 prose-h3:text-xl prose-h3:font-semibold
        prose-p:leading-8 prose-p:text-foreground/90
        prose-a:text-primary prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
        prose-strong:text-foreground
        prose-li:text-foreground/90" data-essay-body>
        <Content />
      </div>

      <footer class="mt-16 border-t border-border pt-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-sm text-muted-foreground">
            Written by <span class="font-semibold text-foreground">{profile.name}</span>
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/writing" class="inline-flex h-10 items-center justify-center rounded-full border border-border bg-card/70 px-5 text-xs font-bold text-foreground transition-all hover:-translate-y-0.5 hover:border-primary/40">
              More writing
            </a>
            <a href="/contact" class="inline-flex h-10 items-center justify-center rounded-full bg-primary px-5 text-xs font-bold text-primary-foreground transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20">
              Get in touch
            </a>
          </div>
        </div>
      </footer>
    </article>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} is:inline />
</BaseLayout>
