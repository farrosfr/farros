---
import BaseLayout from '../layouts/BaseLayout.astro';
import AvailabilityBadge from '../components/AvailabilityBadge.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { profile } from '../data/profile';

// Web3Forms access key. Sign up free at https://web3forms.com — the key
// is then embedded in the form (it's a public client identifier, not a
// server secret). If unset, the form falls back to opening the user's
// email client with a prefilled body — that path requires no setup.
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const formConfigured = web3formsKey.length > 0;

const subjects = [
  'Web development project',
  'Security review',
  'Data engineering',
  'AI / automation',
  'Browser extension',
  'Infrastructure',
  'Other',
];

const directLinks = [
  { label: 'Email', detail: profile.email, href: `mailto:${profile.email}`, icon: 'i-lucide-mail' },
  { label: 'WhatsApp', detail: '+62 822 3405 7613', href: `https://wa.me/${profile.whatsapp}`, icon: 'i-simple-icons-whatsapp' },
  { label: 'GitHub', detail: 'farrosfr', href: profile.github, icon: 'i-simple-icons-github' },
  { label: 'LinkedIn', detail: 'in/farrosfr', href: profile.linkedin, icon: 'i-simple-icons-linkedin' },
  { label: 'X', detail: '@farrosfr_', href: profile.x, icon: 'i-simple-icons-x' },
  { label: 'Writing', detail: 'farrosfr.com', href: 'https://farrosfr.com', icon: 'i-lucide-notebook-pen' },
];
---

<BaseLayout
  title={`Contact | ${profile.shortName}`}
  description="Start a conversation about a web project, security review, data engineering work, or anything else worth a reply."
>
  <main class="mx-auto max-w-screen-xl px-4 py-12 sm:px-6 lg:px-8" data-reveal>
    <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} class="mb-8" />
    <section class="py-6 md:py-10">
      <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-primary">Contact</p>
          <h1 class="text-5xl font-bold leading-[0.95] tracking-tight text-foreground sm:text-6xl">
            Start a conversation.
          </h1>
          <div class="mt-6">
            <AvailabilityBadge availability={profile.availability} size="md" showNextSlot />
          </div>
        </div>
        <p class="max-w-2xl text-lg leading-8 text-muted-foreground lg:justify-self-end">
          Web projects, security reviews, data engineering work, or anything else worth a thoughtful reply — drop a note and I will get back to you within a couple of business days.
        </p>
      </div>
    </section>

    <section class="grid gap-6 pb-20 md:pb-28 lg:grid-cols-[1.2fr_0.8fr]">
      <form
        data-contact-form
        data-web3forms-key={web3formsKey}
        data-configured={formConfigured ? 'true' : 'false'}
        data-fallback-email={profile.email}
        class="glass-card flex flex-col gap-5 rounded-[1.5rem] p-6 sm:p-8"
        novalidate
      >
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Message</p>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Tell me what you are working on.</h2>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-2 text-sm font-semibold text-foreground">
            <span>Name</span>
            <input
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Your full name"
              class="h-12 rounded-2xl border border-border/70 bg-background/65 px-4 text-sm font-medium text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary/60 focus:ring-2 focus:ring-primary/30"
            />
          </label>
          <label class="flex flex-col gap-2 text-sm font-semibold text-foreground">
            <span>Email</span>
            <input
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
              class="h-12 rounded-2xl border border-border/70 bg-background/65 px-4 text-sm font-medium text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary/60 focus:ring-2 focus:ring-primary/30"
            />
          </label>
        </div>

        <label class="flex flex-col gap-2 text-sm font-semibold text-foreground">
          <span>Subject</span>
          <select
            name="subject"
            required
            class="h-12 rounded-2xl border border-border/70 bg-background/65 px-4 text-sm font-medium text-foreground outline-none transition-colors focus:border-primary/60 focus:ring-2 focus:ring-primary/30"
          >
            <option value="" disabled selected>Pick a topic</option>
            {subjects.map((subject) => <option value={subject}>{subject}</option>)}
            <option value="__custom__">Something else (write it in the message)</option>
          </select>
        </label>

        <label class="flex flex-col gap-2 text-sm font-semibold text-foreground">
          <span>Message</span>
          <textarea
            name="message"
            required
            rows="6"
            placeholder="A short summary of what you need, key constraints, and a realistic timeline."
            class="rounded-2xl border border-border/70 bg-background/65 px-4 py-3 text-sm font-medium text-foreground outline-none transition-colors placeholder:text-muted-foreground focus:border-primary/60 focus:ring-2 focus:ring-primary/30"
          ></textarea>
        </label>

        {/* Honeypot: hidden from real users, irresistible to bots. */}
        <div aria-hidden="true" class="hidden">
          <label>
            Leave this field empty
            <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs leading-5 text-muted-foreground">
            {formConfigured
              ? 'Powered by Web3Forms. Replies usually within two business days.'
              : `No backend configured — the form will open your email client addressed to ${profile.email}.`}
          </p>
          <button
            type="submit"
            data-submit-button
            class="inline-flex h-12 items-center justify-center rounded-full bg-primary px-8 text-sm font-bold text-primary-foreground transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 focus:outline-none focus:ring-2 focus:ring-primary/50 disabled:cursor-not-allowed disabled:opacity-60"
          >
            <span data-submit-label>Send message</span>
            <span data-submit-spinner class="i-lucide-loader-circle ml-2 hidden size-4 animate-spin"></span>
          </button>
        </div>

        <p
          data-form-status
          role="status"
          aria-live="polite"
          class="hidden rounded-2xl border px-4 py-3 text-sm"
        ></p>
      </form>

      <aside class="flex flex-col gap-4">
        <div class="glass-card rounded-[1.5rem] p-6">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Direct lines</p>
          <p class="mt-2 text-base font-bold text-foreground">Reach me without filling the form.</p>
          <ul class="mt-5 flex flex-col gap-2">
            {directLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.href.startsWith('http') ? '_blank' : undefined}
                  rel={item.href.startsWith('http') ? 'noreferrer' : undefined}
                  class="group flex items-center justify-between gap-3 rounded-2xl border border-border/70 bg-background/65 p-3 transition-colors hover:border-primary/40"
                >
                  <div class="flex min-w-0 items-center gap-3">
                    <span class={`${item.icon} size-5 text-muted-foreground transition-colors group-hover:text-primary`}></span>
                    <div class="min-w-0">
                      <p class="text-sm font-bold text-foreground">{item.label}</p>
                      <p class="truncate text-xs text-muted-foreground">{item.detail}</p>
                    </div>
                  </div>
                  <span class="i-lucide-arrow-up-right size-4 text-muted-foreground transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-primary"></span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="glass-card rounded-[1.5rem] p-6">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">Response time</p>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            Most replies land within two business days. If something is urgent, WhatsApp is the fastest path during working hours (WIB, UTC+7).
          </p>
        </div>
      </aside>
    </section>
  </main>
</BaseLayout>

<script>
  type FormStatus = { kind: 'idle' | 'sending' | 'success' | 'error'; message?: string };

  function statusClasses(kind: FormStatus['kind']) {
    if (kind === 'success') return 'border-primary/40 bg-primary/10 text-primary';
    if (kind === 'error') return 'border-red-500/40 bg-red-500/10 text-red-500';
    return 'border-border bg-card/70 text-muted-foreground';
  }

  function setupContactForm() {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const key = form.dataset.web3formsKey ?? '';
    const configured = form.dataset.configured === 'true';
    const fallbackEmail = form.dataset.fallbackEmail ?? '';
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const submitSpinner = form.querySelector<HTMLElement>('[data-submit-spinner]');
    const statusEl = form.querySelector<HTMLElement>('[data-form-status]');

    const setStatus = ({ kind, message }: FormStatus) => {
      if (!statusEl) return;
      statusEl.className = `rounded-2xl border px-4 py-3 text-sm ${statusClasses(kind)}`;
      statusEl.textContent = message ?? '';
      if (kind === 'idle' || !message) {
        statusEl.classList.add('hidden');
      } else {
        statusEl.classList.remove('hidden');
      }
    };

    const setBusy = (busy: boolean) => {
      if (!submitButton || !submitLabel || !submitSpinner) return;
      submitButton.disabled = busy;
      submitLabel.textContent = busy ? 'Sending…' : 'Send message';
      submitSpinner.classList.toggle('hidden', !busy);
    };

    const openMailClient = (data: Record<string, string>) => {
      const subject = `[${data.subject}] from ${data.name}`;
      const body = `Hi Farros,\n\n${data.message}\n\n—\n${data.name}\n${data.email}`;
      const link = `mailto:${fallbackEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      window.location.href = link;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries()) as Record<string, string>;

      // Honeypot: if filled, silently succeed so bots don't learn anything.
      if (data.company_website && data.company_website.trim() !== '') {
        setStatus({ kind: 'success', message: 'Message sent. I will reply soon.' });
        form.reset();
        return;
      }

      if (!data.name || !data.email || !data.subject || !data.message) {
        setStatus({ kind: 'error', message: 'Please fill in name, email, subject, and message.' });
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
        setStatus({ kind: 'error', message: 'That email address does not look right.' });
        return;
      }
      if (data.subject === '__custom__') {
        setStatus({ kind: 'error', message: 'Please describe the topic in the message body or pick one from the list.' });
        return;
      }

      setBusy(true);
      setStatus({ kind: 'sending', message: 'Sending your message…' });

      try {
        if (configured && key) {
          const payload = new FormData();
          payload.append('access_key', key);
          payload.append('from_name', data.name);
          payload.append('replyto', data.email);
          payload.append('subject', `[farros.co] ${data.subject}`);
          payload.append('message', `${data.message}\n\n— ${data.name} <${data.email}>`);
          payload.append('botcheck', '');

          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            body: payload,
          });
          const result = (await response.json()) as { success?: boolean; message?: string };
          if (response.ok && result.success) {
            setStatus({ kind: 'success', message: 'Message sent. I will reply within two business days.' });
            form.reset();
          } else {
            throw new Error(result.message ?? 'Web3Forms rejected the submission.');
          }
        } else {
          // No backend: open the user's email client with prefilled body.
          // Treat as a soft success — the user has to actually click send.
          openMailClient(data);
          setStatus({
            kind: 'success',
            message: 'Opened your email client with the message pre-filled. Hit send and you are done.',
          });
          // Don't reset; user may want to verify the prefilled body.
        }
      } catch (error) {
        const detail = error instanceof Error ? error.message : 'Something went wrong.';
        setStatus({ kind: 'error', message: `Could not send: ${detail}. Email ${fallbackEmail} directly.` });
      } finally {
        setBusy(false);
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
