---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, projects } from '../data/profile';
---

<BaseLayout title={`Web Portfolio | ${profile.name}`} description="Full website portfolio by Farros across Astro themes, e-commerce, education, energy, marketplaces, and service websites.">
  <section class="py-14 md:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div>
        <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-primary">Web portfolio</p>
        <h1 class="text-5xl font-bold leading-[0.95] tracking-tight sm:text-6xl">Production websites and public web systems.</h1>
      </div>
      <p class="max-w-2xl text-lg leading-8 text-muted-foreground lg:justify-self-end">
        Full list of live web projects, from Astro themes and education products to industrial commerce, renewable energy, marketplace, and service websites.
      </p>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
      {projects.map((project) => (
        <a
          href={project.href}
          target="_blank"
          rel="noreferrer"
          class={`group glass-card flex min-h-full flex-col overflow-hidden rounded-[1.25rem] transition-all hover:-translate-y-1 ${project.featured ? 'ring-1 ring-primary/30' : ''}`}
        >
          <div class="relative h-52 overflow-hidden border-b border-border/70 bg-muted">
            <img src={project.image} alt={`${project.name} website screenshot`} class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
            <span class="absolute left-3 top-3 rounded-full border border-border/70 bg-background/85 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-primary backdrop-blur">
              {project.category}
            </span>
            {project.featured && (
              <span class="absolute right-3 top-3 rounded-full border border-primary/30 bg-primary/15 px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-primary backdrop-blur">
                Top
              </span>
            )}
          </div>

          <div class="flex flex-1 flex-col p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-muted-foreground">{project.domain}</p>
                <h2 class="mt-2 text-xl font-bold tracking-tight text-foreground">{project.name}</h2>
              </div>
              <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-border bg-background/70 text-muted-foreground transition-all group-hover:border-primary/50 group-hover:text-primary">
                <span class="i-lucide-arrow-up-right size-5"></span>
              </span>
            </div>
            <p class="mt-4 flex-1 text-sm leading-6 text-muted-foreground transition-colors group-hover:text-foreground">{project.description}</p>
            <div class="mt-5 inline-flex w-fit rounded-full border border-border/70 bg-background/70 px-3 py-1 font-mono text-[11px] text-primary">
              {project.outcome}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
