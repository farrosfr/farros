---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Open Graph type. Defaults to "website". Use "article" for blog posts / essays. */
  ogType?: 'website' | 'article' | 'profile';
}

const {
  title = 'Farros | Full-Stack Developer & Cybersecurity Researcher',
  description = 'Astro developer, system architect, data engineer, browser extension developer, and cybersecurity writer building practical web and infrastructure systems.',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Build a per-page OG image URL. The endpoint at /og.png takes the
// page title and description as query params and renders a branded
// 1200x630 PNG at build time. Falls back to the site logo if
// title/description are missing.
const ogImageURL = new URL(
  `/og.png?title=${encodeURIComponent(title)}&subtitle=${encodeURIComponent(description)}`,
  Astro.site,
);

// Cloudflare Web Analytics is opt-in. If the user has set
// PUBLIC_CF_ANALYTICS_TOKEN in .env, emit the beacon. No-op otherwise.
// CF inserts a privacy-friendly script (no cookies, no personal data).
const cfBeaconToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';

// Google Search Console Site Verification (optional).
// Add meta tag for domain ownership verification if set in .env.
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';

// Site-wide WebSite schema with SearchAction. The Person schema lives
// separately so we can extend it without touching this block.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: profile.shortName,
  url: profile.website,
  description,
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: profile.name,
    url: profile.website,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalURL} />
    <script is:inline>
      const themeMode = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const shouldUseDark = themeMode === 'dark' || (!themeMode && prefersDark);
      document.documentElement.classList.toggle('dark', shouldUseDark);
      document.documentElement.dataset.themeMode = themeMode || 'system';
    </script>
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {googleSiteVerification && (
      <meta name="google-site-verification" content={googleSiteVerification} />
    )}
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook, LinkedIn, Slack, Discord, WhatsApp) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={profile.shortName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@farrosfr_" />
    <meta name="twitter:creator" content="@farrosfr_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <meta name="theme-color" content="#070b12" />

    <!-- Cloudflare Web Analytics (opt-in via PUBLIC_CF_ANALYTICS_TOKEN).
         Privacy-friendly: no cookies, no personal data, no fingerprinting.
         Get your beacon token at https://dash.cloudflare.com/?to=/:account/web-analytics -->
    {cfBeaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
      ></script>
    )}

    <!-- Person schema: author identity for knowledge panels and rich results -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.name,
      url: profile.website,
      email: profile.email,
      sameAs: [profile.github, profile.linkedin, profile.medium, profile.x],
      jobTitle: profile.title,
      description: profile.summary,
    })} />

    <!-- WebSite schema: site-level metadata + author link -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <ClientRouter />
    <script is:inline>
      // Scroll-reveal: adds .is-revealed to [data-reveal] elements when
      // they enter the viewport. Tiny vanilla IntersectionObserver, no
      // animation library. Stagger is controlled per-element via the
      // --reveal-delay CSS custom property (e.g. style="--reveal-delay: 120ms").
      function setupReveal() {
        const targets = document.querySelectorAll('[data-reveal]:not(.is-revealed)');
        if (!targets.length) return;

        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observer = new IntersectionObserver((entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              obs.unobserve(entry.target);
            }
          }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

        targets.forEach((el) => observer.observe(el));
      }

      // Run once on initial load and again after every Astro view transition.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupReveal);
      } else {
        setupReveal();
      }
      document.addEventListener('astro:page-load', setupReveal);
    </script>
  </head>
  <body class="bg-background text-foreground font-sans antialiased flex flex-col min-h-screen selection:bg-primary/30 selection:text-foreground">
    <Header />
    <main class="flex-grow mx-auto max-w-screen-xl px-5 sm:px-6 md:px-10 lg:px-16 w-full">
      <slot />
    </main>
    <div class="mx-auto max-w-screen-xl px-5 sm:px-6 md:px-10 lg:px-16 w-full">
      <Footer />
    </div>
  </body>
</html>
